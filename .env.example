# Site values (see README "Deploy"). Copy to .env (mode 600, gitignored) and fill in.
AGENT_REPORTS_HOST=reports.example.com
AGENT_REPORTS_PUBLIC_URL=https://reports.example.com
AGENT_REPORTS_REGISTRY=ghcr.io/your-user
ACME_EMAIL=you@example.com
# Empty = current kubectl context.
AGENT_REPORTS_KUBE_CONTEXT=
# Namespace every object is created in (default agent-reports).
AGENT_REPORTS_NAMESPACE=agent-reports
# Image pull Secret in that namespace (`task secrets` copies it there).
AGENT_REPORTS_PULL_SECRET=registry-credentials

# Secrets.
# Session cookie value: exactly 64 lowercase hex chars (openssl rand -hex 32).
AGENT_REPORTS_SESSION_TOKEN=
AGENT_REPORTS_BASIC_AUTH_USER=
# 1..72 bytes (bcrypt reads at most 72). `task apply` stores it as a bcrypt
# htpasswd line in Secret agent-reports-auth; Traefik caps /api/login at 20
# requests/minute. Keep it out of shell history.
AGENT_REPORTS_BASIC_AUTH_PASSWORD=
